{
  "name": "aurora-music",
  "version": "0.3.0",
  "description": "Aurora Music - 本地音乐 + 游戏混音一体化播放器",
  "main": "out/main/index.js",
  "author": "Aurora Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.aurora.music",
    "productName": "Aurora Music",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurora Music"
    }
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "koffi": "^3.1.4",
    "music-metadata": "^7.14.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.25",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.0.0",
    "sass": "^1.71.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vitest": "^1.3.1",
    "vue-tsc": "^2.0.6"
  }
}
